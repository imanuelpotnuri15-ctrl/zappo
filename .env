# Server port
PORT=3000

# JWT secret — change this to a long random string in production
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-something-long-and-random

# Giphy API key — get free at https://developers.giphy.com/dashboard/
# Without this, GIFs won't load (stickers and emoji still work fine)
GIPHY_KEY=your_giphy_api_key_here
